# API smallcaps-screener lue par le pont v5 (market_intelligence/v5_bridge.py).
# ⚠️ Loopback uniquement : l'API n'a pas d'authentification et sert des valeurs
# de l'edge non versionné — ne JAMAIS pointer vers une URL publique.
SMALLCAPS_API_URL=http://localhost:8000

# Autorise le module Node "fs" dans les Code nodes n8n (lecture watchlist/portfolio.json)
NODE_FUNCTION_ALLOW_BUILTIN=fs

# REQUIS. n8n 2.20+ exclut par défaut le nœud Execute Command
# (n8n-nodes-base.executeCommand). Or le nœud « Run EOD Anomaly Pipeline » en est un :
# sans override, l'activation du workflow échoue ("Unrecognized node type: executeCommand")
# et AUCUN trigger ne s'arme. [] retire toute exclusion et réautorise executeCommand.
# ⚠️ Sécurité : autorise l'exécution de commandes shell par les workflows n8n (user warren).
NODES_EXCLUDE=[]
