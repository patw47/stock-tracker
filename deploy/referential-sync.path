[Unit]
# Surveille la moitie CONFIGURATION du referentiel (seuils, table des facteurs
# sectoriels, quarantaine) : ce qui se decide et reste versionne.
# Depuis l'Epic 10 S4 les fichiers d'ETAT (registry.json, classifications.json,
# single_factor_symbols.json) vivent sous runtime/referential/, hors de ce chemin
# et hors de git : ils suivent la cohorte, donc ils n'ont plus a etre commites
# pour survivre a un `git reset --hard` de deploiement.
Description=Surveille market_intelligence/data/ (configuration du referentiel)

[Path]
PathChanged=/opt/apps/stock-tracker/market_intelligence/data
Unit=referential-sync.service

[Install]
WantedBy=multi-user.target
