[Unit]
Description=Stock Tracker v5 bridge (reconcile watchlist.json with the smallcaps v5 cohort tracking)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=queenp
WorkingDirectory=/opt/apps/stock-tracker
# No API URL: the screener lives on the workstation, behind a home router, and
# was never reachable from here. The workstation pushes /api/scan into
# runtime/screener/latest.json (deploy/screener-push.*) and the bridge reads it.
ExecStart=/usr/bin/python3 -m market_intelligence.v5_bridge
