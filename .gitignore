# Orchestration metadata (never commit — causes merge conflicts across worktrees)
.ticket-id

# Secrets
.env

# n8n data (database, encryption key, logs)
n8n-data/
n8n.log
n8n.pid

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Python bytecode (was leaking into agent commits → merge conflicts)
__pycache__/
*.py[cod]

# Runtime ticker lists — edited live via Telegram (/modifywatchlist, /modifyportfolio).
# Untracked so `git reset --hard` on deploy keeps user edits. Seeded from *.example.json.
watchlist.json
portfolio.json
