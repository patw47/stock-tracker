# Orchestration metadata (never commit — causes merge conflicts across worktrees)
.ticket-id

# Secrets
.env

# n8n data (database, encryption key, logs)
n8n-data/
n8n.log
n8n.pid

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Python bytecode (was leaking into agent commits → merge conflicts)
__pycache__/
*.py[cod]

# Runtime ticker lists — edited live via Telegram (/modifywatchlist, /modifyportfolio).
# Untracked so `git reset --hard` on deploy keeps user edits. Seeded from *.example.json.
watchlist.json
portfolio.json

# Runtime anomaly state, and since Epic 10 S4 the referential state too:
# runtime/referential/registry.json, classifications.json, single_factor_symbols.json.
# Elles suivent la cohorte, donc elles changent tous les jours — un `git reset --hard`
# de déploiement les détruirait, ce pour quoi un commit automatique devait exister.
# Ce qui se décide (seuils, table des facteurs sectoriels, quarantaine) reste versionné
# dans market_intelligence/data/.
runtime/

# Agent tooling & local orchestration (machine-specific ; symlinks vers l'Obsidian vault).
# Ne doivent plus être versionnés — présents en local, ignorés côté repo.
.claude/
.codex/
.conventions
.epic.md
.rules
.sprint.md
AGENTS.md
CLAUDE.md
