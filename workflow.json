      "name": "Run EOD Pipeline (deploy dry-run)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        520,
        960
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = ($json.stdout || '').trim();\nif (!raw) {\n  throw new Error('EOD anomaly runner produced no JSON payload');\n}\nlet payload;\ntry {\n  payload = JSON.parse(raw);\n} catch (error) {\n  throw new Error('Invalid EOD anomaly JSON payload: ' + error.message + '\\n' + raw.slice(0, 500));\n}\nreturn [{ json: payload }];",
        "mode": "runOnceForAllItems"
      },
      "id": "node-eod-parse-result",
      "name": "Parse EOD Anomaly Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        760
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-eod-survivors",
              "leftValue": "={{ $json.survivor_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "cond-eod-should-send",
              "leftValue": "={{ $json.should_send }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-eod-if-survivors",
