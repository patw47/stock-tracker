    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:18795/macro-brief",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {}
      },
      "id": "node-call-macro-brief",
      "name": "Call Warren Macro Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        520,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nlet warrenText = '';\nif (typeof data.brief === 'string') {\n  warrenText = data.brief.trim();\n} else if (data.error) {\n  warrenText = 'Erreur brief macro : ' + data.error;\n}\nif (!warrenText) {\n  warrenText = 'Brief macro indisponible.';\n}\nreturn [{ json: { warrenText } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "node-extract-macro-brief",
      "name": "Extract Macro Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        520
      ]
    }
  ],
