{
  "id": "veille-boursiere-001",
  "name": "Daily Stock Market Watch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 16 * * 1-5"
            }
          ]
        }
      },
      "id": "node-schedule",
      "name": "Layer A News Schedule 16h Mon-Fri",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst portfolio = JSON.parse(fs.readFileSync('/opt/apps/stock-tracker/portfolio.json', 'utf8'));\nconst watchlist = JSON.parse(fs.readFileSync('/opt/apps/stock-tracker/watchlist.json', 'utf8'));\nconst tickers = [\n  ...(portfolio.tickers || []).map(t => ({ symbol: t.symbol, sector: t.sector, status: 'portfolio' })),\n  ...(watchlist.tickers || []).map(t => ({ symbol: t.symbol, sector: t.sector, status: 'watchlist' }))\n];\nreturn tickers.map(t => ({ json: t }));",
        "mode": "runOnceForAllItems"
      },
      "id": "node-read-watchlist",
      "name": "Read Tickers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst today = new Date().toISOString().slice(0, 10);\n\nreturn items.map(item => {\n  const { symbol, sector, status } = item.json;\n  const prompt = `Today is ${today}. Search the web for news about ${symbol} stock (${sector}) from TODAY ONLY.\\nReturn up to 3 significant news items from today (earnings, partnerships, FDA decisions, analyst upgrades/downgrades, regulatory news, major price catalysts).\\nIf no news from today exists, respond exactly: NO_NEWS_TODAY\\nFormat: concise bullet points only. No analysis.`;\n  const body = {\n    model: 'claude-haiku-4-5-20251001',\n    max_tokens: 512,\n    tools: [{ type: 'web_search_20250305', name: 'web_search', max_uses: 3 }],\n    messages: [{ role: 'user', content: prompt }]\n  };\n  return { json: { symbol, sector, status, body } };\n});",
        "mode": "runOnceForAllItems"
      },
      "id": "node-prep-haiku",
      "name": "Prepare Haiku Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "web-search-2025-03-05"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "node-haiku-api",
      "name": "Claude Haiku API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        900,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "5SwID15GVGrROnky",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nconst prep = $('Prepare Haiku Request').item.json;\nconst symbol = prep.symbol;\nconst sector = prep.sector;\nconst status = prep.status;\n\nlet text = '';\nif (data.content && Array.isArray(data.content)) {\n  for (const block of data.content) {\n    if (block.type === 'text') text += block.text;\n  }\n}\nif (data.error) text = 'NO_NEWS_TODAY';\n\nreturn { json: { symbol, sector, status, rawNews: text.trim() || 'NO_NEWS_TODAY' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "node-extract-news",
      "name": "Extract Raw News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const news = {};\nfor (const item of $input.all()) {\n  news[item.json.symbol] = item.json.rawNews;\n}\nreturn [{ json: { news } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "node-aggregate-news",
      "name": "Aggregate All News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:18795/filter",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ news: $json.news }) }}",
        "options": {}
      },
      "id": "node-call-filter",
      "name": "Call Warren Filter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nconst allNews = $('Aggregate All News').first().json.news || {};\nconst newTickers = Array.isArray(data.new) ? data.new : Object.keys(allNews);\nconst skipTickers = Array.isArray(data.skip) ? data.skip : [];\nconst newCount = newTickers.length;\nreturn [{ json: { newTickers, skipTickers, newCount, allNews } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "node-extract-filter",
      "name": "Extract Filter Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-new-tickers",
              "leftValue": "={{ $json.newCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-new",
      "name": "If New Items",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:18795/memorize",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ newTickers: $json.newTickers, allNews: $json.allNews }) }}",
        "options": {}
      },
      "id": "node-call-memorize",
      "name": "Call Memorize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        2220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const warrenText = $input.first().json.warrenText;\nconst text = (warrenText && warrenText.trim())\n  ? warrenText.trim()\n  : \"Aucune actualité pertinente aujourd'hui. Bonne journée.\";\nreturn [{ json: { text } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "node-aggregate-telegram",
      "name": "Aggregate for Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text || \"Aucune actualité pertinente aujourd'hui.\";\nconst MAX = 4000;\n\nif (text.length <= MAX) {\n  return [{ json: { chunk: text } }];\n}\n\nconst paragraphs = text.split(/\\n\\n+/);\nconst chunks = [];\nlet current = '';\n\nfor (const para of paragraphs) {\n  const candidate = current ? current + '\\n\\n' + para : para;\n  if (candidate.length > MAX) {\n    if (current) chunks.push(current);\n    current = para.length > MAX ? para.slice(0, MAX) : para;\n  } else {\n    current = candidate;\n  }\n}\nif (current) chunks.push(current);\n\nreturn chunks.map((chunk, i) => ({\n  json: { chunk: chunks.length > 1 ? '_(' + (i+1) + '/' + chunks.length + ')_\\n\\n' + chunk : chunk }\n}));",
        "mode": "runOnceForAllItems"
      },
      "id": "node-split-telegram",
      "name": "Split for Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3100,
        440
      ]
    },
    {
      "parameters": {
        "chatId": "1543956122",
        "text": "={{ $json.chunk }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "appendAttribution": false
        }
      },
      "id": "node-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        3320,
        440
      ],
      "credentials": {
        "telegramApi": {
          "id": "HBbPM9dctkeKAwG1",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "node-exec-trigger",
      "name": "Execute Trigger (deploy)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -100,
        500
      ],
      "parameters": {}
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 21 * * 1-5"
            }
          ]
        },
        "timezone": "UTC"
